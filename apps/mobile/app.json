{
  "expo": {
    "name": "Archivist",
    "slug": "archivist-grand-archive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "archivist",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.publisher.archivist",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Archivist uses the camera to scan cards into decklists."
      }
    },
    "android": {
      "package": "com.publisher.archivist",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Archivist uses the camera to scan cards into decklists.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "extra": {
      "grandArchiveApiBaseUrl": "https://api.gatcg.com",
      "catalogSyncBatchSize": 100,
      "scannerConfidenceThresholds": {
        "exactFooterAutoAdd": 0.92,
        "nameOnlyConfirmation": 0.85
      },
      "features": {
        "collectionMode": false,
        "cloudSync": false
      },
      "router": {},
      "eas": {
        "projectId": "abcdceb1-0677-4d30-bdc5-ba499b5eb52c"
      }
    },
    "owner": "godemperors-team"
  }
}
